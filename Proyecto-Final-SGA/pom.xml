<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ======================================== -->
    <!-- INFORMACION GENERAL DEL PROYECTO         -->
    <!-- ======================================== -->

    <groupId>co.edu.uniquindio</groupId>
    <artifactId>sga-alojamiento</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>SGA - Aparta-Suites UQ</name>
    <description>
        Proyecto final de Estructuras de Datos 2026-2.
        Sistema de Gestion de Alojamiento.
    </description>

    <!-- ======================================== -->
    <!-- PROPIEDADES Y VERSIONES                  -->
    <!-- ======================================== -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Version del JDK -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Versiones de dependencias -->
        <javafx.version>21.0.13</javafx.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <!-- ======================================== -->
    <!-- DEPENDENCIAS DEL PROYECTO                -->
    <!-- ======================================== -->

    <dependencies>

        <!-- JavaFX: componentes graficos -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX: interfaces FXML -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JUnit 5: pruebas unitarias -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ======================================== -->
    <!-- CONFIGURACION DE COMPILACION             -->
    <!-- ======================================== -->

    <build>
        <plugins>

            <!-- Compilador Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Ejecucion de pruebas JUnit -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!-- Ejecucion de la aplicacion JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>co.edu.uniquindio.sga.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Configuracion del archivo JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>
                                co.edu.uniquindio.sga.Main
                            </mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
