<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.sga.interfaz.controladores.HuespedController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="reservas-scroll">

    <content>
        <VBox spacing="16" styleClass="reservas-root">

            <!-- Encabezado -->
            <HBox alignment="CENTER_LEFT" spacing="12">

                <VBox spacing="4" HBox.hgrow="ALWAYS">

                    <Label text="GESTIÓN DE CLIENTES"
                           styleClass="eyebrow"/>

                    <Label text="Gestión de huéspedes"
                           styleClass="screen-title"/>

                    <Label text="Administra los perfiles, consulta información personal y gestiona los apartamentos favoritos."
                           wrapText="true"
                           styleClass="screen-subtitle"/>

                </VBox>

                <Label text="DATOS TEMPORALES · DEMO"
                       styleClass="demo-badge"/>

            </HBox>

            <!-- Registro y búsqueda -->
            <GridPane hgap="14" vgap="14">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"
                                       hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50"
                                       hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Registro -->
                <VBox spacing="12"
                      styleClass="section-card"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <Label text="1. Registrar huésped"
                           styleClass="section-title"/>

                    <Label text="Ingresa los datos personales y de contacto."
                           styleClass="helper-text"
                           wrapText="true"/>

                    <Label text="Documento"
                           styleClass="field-label"/>

                    <TextField fx:id="documentoField"
                               promptText="Número de documento"/>

                    <Label text="Nombre completo"
                           styleClass="field-label"/>

                    <TextField fx:id="nombreField"
                               promptText="Nombre y apellidos"/>

                    <Label text="Fecha de nacimiento"
                           styleClass="field-label"/>

                    <DatePicker fx:id="fechaNacimientoPicker"
                                promptText="Seleccionar fecha"
                                maxWidth="Infinity"/>

                    <Label text="Teléfono"
                           styleClass="field-label"/>

                    <TextField fx:id="telefonoField"
                               promptText="Número de contacto"/>

                    <Label text="Correo electrónico"
                           styleClass="field-label"/>

                    <TextField fx:id="correoField"
                               promptText="Correo electrónico"/>

                    <Label text="Fotografía (opcional)"
                           styleClass="field-label"/>

                    <TextField fx:id="fotoField"
                               promptText="Ruta o referencia de la fotografía"/>

                    <Button text="Registrar huésped"
                            onAction="#registrarHuesped"
                            styleClass="primary-button"
                            maxWidth="Infinity"/>

                </VBox>

                <!-- Consulta -->
                <VBox spacing="12"
                      styleClass="section-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <Label text="2. Consultar huésped"
                           styleClass="section-title"/>

                    <Label text="Busca un perfil mediante su documento."
                           styleClass="helper-text"
                           wrapText="true"/>

                    <Label text="Documento del huésped"
                           styleClass="field-label"/>

                    <HBox spacing="8">

                        <TextField fx:id="documentoConsultaField"
                                   promptText="Ingresa el documento"
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="Buscar"
                                onAction="#buscarHuesped"
                                styleClass="primary-button"/>

                    </HBox>

                    <Label text="Información del perfil"
                           styleClass="field-label"/>

                    <GridPane hgap="8" vgap="12">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="36"/>
                            <ColumnConstraints percentWidth="64"/>
                        </columnConstraints>

                        <Label text="Documento:"
                               styleClass="helper-text"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="documentoResultadoLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Nombre:"
                               styleClass="helper-text"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="nombreResultadoLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                        <Label text="Nacimiento:"
                               styleClass="helper-text"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="nacimientoResultadoLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                        <Label text="Teléfono:"
                               styleClass="helper-text"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="telefonoResultadoLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                        <Label text="Correo:"
                               styleClass="helper-text"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="correoResultadoLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="1"/>

                    </GridPane>

                    <Label fx:id="estadoResultadoLabel"
                           text="Busca un huésped por su número de documento."
                           wrapText="true"
                           styleClass="inline-status"/>

                </VBox>

            </GridPane>

            <!-- Favoritos -->
            <VBox spacing="12"
                  styleClass="section-card">

                <Label text="3. Apartamentos favoritos"
                       styleClass="section-title"/>

                <Label text="Administra los apartamentos preferidos del huésped seleccionado."
                       styleClass="helper-text"
                       wrapText="true"/>

                <Label text="Seleccionar apartamento"
                       styleClass="field-label"/>

                <ComboBox fx:id="apartamentoCombo"
                          promptText="Selecciona un apartamento"
                          maxWidth="Infinity"/>

                <HBox spacing="8">

                    <Button text="Agregar a favoritos"
                            onAction="#agregarFavorito"
                            styleClass="secondary-button"/>

                    <Button text="Eliminar seleccionado"
                            onAction="#eliminarFavorito"
                            styleClass="quiet-button"/>

                </HBox>

                <Label text="Apartamentos guardados"
                       styleClass="field-label"/>

                <ListView fx:id="favoritosListView"
                          prefHeight="135"
                          minHeight="100">

                    <placeholder>
                        <Label text="No hay apartamentos favoritos registrados."
                               styleClass="helper-text"/>
                    </placeholder>

                </ListView>

                <Label fx:id="favoritosCantidadLabel"
                       text="Apartamentos favoritos: 0"
                       styleClass="inline-status"/>

            </VBox>

            <!-- Historial -->
            <VBox spacing="12"
                  styleClass="section-card">

                <Label text="4. Historial de estancias"
                       styleClass="section-title"/>

                <Label text="Consulta las reservas finalizadas asociadas al huésped titular."
                       styleClass="helper-text"
                       wrapText="true"/>

                <ListView fx:id="historialListView"
                          prefHeight="165"
                          minHeight="120">

                    <placeholder>
                        <Label text="No existen estancias finalizadas registradas."
                               styleClass="helper-text"/>
                    </placeholder>

                </ListView>

                <Label fx:id="historialCantidadLabel"
                       text="Estancias finalizadas: 0"
                       styleClass="inline-status"/>

            </VBox>

            <!-- Aviso -->
            <Label text="DEMO: los perfiles, favoritos e historiales se almacenan temporalmente en memoria. La información se pierde al cerrar la aplicación."
                   wrapText="true"
                   styleClass="demo-disclaimer"/>

        </VBox>
    </content>

</ScrollPane>
