<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.sga.interfaz.controladores.ReservasController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="reservas-scroll">
    <content>
        <VBox spacing="16" styleClass="reservas-root">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="GESTIÓN COMERCIAL" styleClass="eyebrow" />
                    <Label text="Nueva reserva" styleClass="screen-title" />
                    <Label text="Registra una solicitud, consulta disponibilidad y revisa su cotización."
                           wrapText="true" styleClass="screen-subtitle" />
                </VBox>
                <Label text="DATOS TEMPORALES · DEMO" styleClass="demo-badge" />
            </HBox>

            <VBox spacing="12" styleClass="section-card">
                <VBox spacing="3">
                    <Label text="1. Datos del huésped titular" styleClass="section-title" />
                    <Label text="El titular se incluye automáticamente como una de las personas alojadas."
                           styleClass="helper-text" wrapText="true" />
                </VBox>
                <GridPane hgap="12" vgap="9">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                    </columnConstraints>
                    <Label text="Documento" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label text="Nombre completo" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <TextField fx:id="documentoField" promptText="Número de documento"
                               GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="nombreField" promptText="Nombre y apellidos"
                               GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="Fecha de nacimiento" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <Label text="Teléfono" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <DatePicker fx:id="nacimientoTitularPicker" promptText="Fecha de nacimiento"
                                maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="telefonoField" promptText="Número de contacto"
                               GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    <Label text="Correo electrónico" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                    <TextField fx:id="correoField" promptText="correo@ejemplo.com"
                               GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" />
                </GridPane>
            </VBox>

            <VBox spacing="12" styleClass="section-card">
                <Label text="2. Fechas y alojamiento" styleClass="section-title" />
                <GridPane hgap="12" vgap="9">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                    </columnConstraints>
                    <Label text="Fecha de entrada" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label text="Fecha de salida" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <DatePicker fx:id="entradaPicker" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <DatePicker fx:id="salidaPicker" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="Canal de reserva" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <Label text="Apartamento disponible" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <ComboBox fx:id="canalCombo" maxWidth="Infinity"
                              GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <ComboBox fx:id="apartamentoCombo" promptText="Consulta disponibilidad primero"
                              maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                </GridPane>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="Consultar disponibilidad" onAction="#buscarApartamentosDisponibles"
                            styleClass="secondary-button" />
                    <Label fx:id="cantidadPersonasLabel" text="Personas alojadas: 1 (titular incluido)"
                           styleClass="helper-text" />
                </HBox>
                <Label fx:id="disponibilidadLabel" text="Catálogo temporal cargado. Consulta fechas para filtrar."
                       wrapText="true" styleClass="inline-status" />
            </VBox>

            <VBox spacing="12" styleClass="section-card">
                <VBox spacing="3">
                    <Label text="3. Acompañantes" styleClass="section-title" />
                    <Label text="Agrega las demás personas que se alojarán. Los menores cuentan para la capacidad."
                           styleClass="helper-text" wrapText="true" />
                </VBox>
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="55" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="45" />
                    </columnConstraints>
                    <Label text="Nombre del acompañante" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label text="Fecha de nacimiento" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <TextField fx:id="nombreAcompananteField" promptText="Nombre completo"
                               GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <DatePicker fx:id="nacimientoAcompanantePicker" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="1" />
                </GridPane>
                <HBox spacing="8">
                    <Button text="Agregar acompañante" onAction="#agregarAcompanante"
                            styleClass="secondary-button" />
                    <Button text="Quitar seleccionado" onAction="#quitarAcompanante"
                            styleClass="quiet-button" />
                </HBox>
                <ListView fx:id="acompanantesListView" prefHeight="92" maxHeight="110">
                    <placeholder>
                        <Label text="No se han agregado acompañantes." styleClass="helper-text" />
                    </placeholder>
                </ListView>
            </VBox>

            <VBox spacing="12" styleClass="section-card">
                <Label text="4. Cotización por noche" styleClass="section-title" />
                <HBox spacing="14">
                    <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label text="TOTAL DE LA ESTANCIA" styleClass="metric-label" />
                        <Label fx:id="totalLabel" text="—" styleClass="metric-value" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label text="ANTICIPO PORTAL (30 %)" styleClass="metric-label" />
                        <Label fx:id="anticipoLabel" text="—" styleClass="metric-value-small" />
                    </VBox>
                </HBox>
                <TableView fx:id="tablaDesglose" prefHeight="150" minHeight="120">
                    <placeholder>
                        <Label text="El desglose aparecerá después de registrar una solicitud."
                               styleClass="helper-text" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="nocheColumn" text="Noche" prefWidth="92" />
                        <TableColumn fx:id="temporadaColumn" text="Temporada" prefWidth="85" />
                        <TableColumn fx:id="tarifaColumn" text="Tarifa/persona" prefWidth="112" />
                        <TableColumn fx:id="ocupantesColumn" text="Personas" prefWidth="65" />
                        <TableColumn fx:id="pagadoresColumn" text="Pagan" prefWidth="55" />
                        <TableColumn fx:id="subtotalColumn" text="Subtotal" prefWidth="100" />
                    </columns>
                </TableView>
                <Label text="La salida no se cobra. Los importes son ilustrativos y usan tarifas temporales."
                       styleClass="helper-text" wrapText="true" />
                <Button text="Registrar solicitud de reserva" onAction="#registrarReserva"
                        styleClass="primary-button" maxWidth="Infinity" />
                <Label fx:id="resultadoLabel" text="Completa los datos y consulta la disponibilidad."
                       wrapText="true" styleClass="result-message" />
            </VBox>

            <VBox spacing="10" styleClass="section-card">
                <Label text="Solicitudes registradas en esta sesión" styleClass="section-title" />
                <TableView fx:id="tablaReservas" prefHeight="165" minHeight="130">
                    <placeholder>
                        <Label text="Todavía no se han registrado solicitudes en esta sesión."
                               styleClass="helper-text" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="92" />
                        <TableColumn fx:id="titularColumn" text="Titular" prefWidth="130" />
                        <TableColumn fx:id="apartamentoColumn" text="Apartamento" prefWidth="95" />
                        <TableColumn fx:id="fechasColumn" text="Estancia" prefWidth="150" />
                        <TableColumn fx:id="totalReservaColumn" text="Total" prefWidth="100" />
                        <TableColumn fx:id="canalReservaColumn" text="Canal" prefWidth="70" />
                        <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="85" />
                    </columns>
                </TableView>
            </VBox>

            <Label text="DEMO: catálogo, huéspedes y reservas se mantienen en memoria y se reinician al cerrar la aplicación. No se registran pagos reales. La edad se evalúa a la fecha de entrada como criterio temporal."
                   wrapText="true" styleClass="demo-disclaimer" />
        </VBox>
    </content>
</ScrollPane>
