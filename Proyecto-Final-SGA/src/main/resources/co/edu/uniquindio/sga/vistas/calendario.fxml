<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.sga.interfaz.controladores.CalendarioController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="reservas-scroll">

    <content>
        <VBox spacing="16" styleClass="reservas-root">

            <!-- Encabezado del módulo -->
            <HBox alignment="CENTER_LEFT" spacing="12">

                <VBox spacing="4" HBox.hgrow="ALWAYS">

                    <Label text="GESTIÓN DEL ALOJAMIENTO"
                           styleClass="eyebrow"/>

                    <Label text="Calendario de ocupación"
                           styleClass="screen-title"/>

                    <Label text="Consulta las noches disponibles, las reservas y el estado operativo de cada apartamento."
                           styleClass="screen-subtitle"/>

                </VBox>

                <Label text="DATOS TEMPORALES · DEMO"
                       styleClass="demo-badge"/>

            </HBox>

            <!-- Calendario -->
            <VBox spacing="14" styleClass="section-card">

                <Label text="Ocupación mensual"
                       styleClass="section-title"/>

                <!-- Navegación entre meses -->
                <HBox alignment="CENTER_LEFT" spacing="10">

                    <Button text="◀"
                            onAction="#mesAnterior"
                            styleClass="secondary-button"/>

                    <Label fx:id="mesAnioLabel"
                           text="Noviembre 2026"
                           minWidth="170"
                           styleClass="section-title"/>

                    <Button text="▶"
                            onAction="#mesSiguiente"
                            styleClass="secondary-button"/>

                    <Button text="Actualizar"
                            onAction="#actualizarCalendario"
                            styleClass="quiet-button"/>

                </HBox>

                <!-- Resumen de ocupación -->
                <Label fx:id="resumenLabel"
                       text="Cargando apartamentos..."
                       styleClass="inline-status"/>

                <!-- Cuadrícula del calendario -->
                <ScrollPane fitToHeight="true"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="AS_NEEDED"
                            prefHeight="450"
                            minHeight="300"
                            styleClass="calendario-scroll-interno">

                    <content>
                        <GridPane fx:id="cuadriculaCalendario"
                                  hgap="3"
                                  vgap="3"
                                  styleClass="calendario-grid"/>
                    </content>

                </ScrollPane>

                <!-- Leyenda -->
                <VBox spacing="9">

                    <Label text="Leyenda de ocupación"
                           styleClass="field-label"/>

                    <HBox spacing="14">

                        <Label text="· Disponible"
                               styleClass="leyenda-disponible"/>

                        <Label text="P Pendiente"
                               styleClass="leyenda-pendiente"/>

                        <Label text="C Confirmada"
                               styleClass="leyenda-confirmada"/>

                        <Label text="E En curso"
                               styleClass="leyenda-en-curso"/>

                        <Label text="X Fuera de servicio"
                               styleClass="leyenda-fuera-servicio"/>

                    </HBox>

                </VBox>

                <!-- Detalle de la noche seleccionada -->
                <VBox spacing="8">

                    <Label text="Detalle de la noche seleccionada"
                           styleClass="field-label"/>

                    <Label fx:id="detalleSeleccionLabel"
                           text="Selecciona una noche para consultar su información."
                           styleClass="inline-status"/>

                </VBox>

            </VBox>

            <!-- Aviso de datos temporales -->
            <Label text="DEMO: los apartamentos proceden del catálogo temporal. Las reservas aparecerán aquí cuando sean registradas en el sistema. Los datos se mantienen únicamente en memoria."
                   styleClass="demo-disclaimer"/>

        </VBox>
    </content>

</ScrollPane>
